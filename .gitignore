# OS
.DS_Store
Thumbs.db

# Python
__pycache__/
*.pyc
*.pyo

# Node / React
node_modules/
*.tsbuildinfo

# Build output (generated by pnpm build)
portals/

# Java reactor build artifacts (generated by mvn compile / SEMOSS "Recompile reactors")
classes/
target/

# Environment files (credentials — never commit)
*.local

# Per-environment GovConnect.ai credentials
semoss_config/credentials.env

# Temporary files and backups
temp/

# Screenshots — keep the directory + README, ignore the actual captures.
screenshots/*
!screenshots/README.md

# IDE
.idea/

# Local config files — gitignored, copy from .example to get started.
.mcp.json
semoss_config/environments.json
