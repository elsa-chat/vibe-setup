# SEMOSS Credentials (required for MCP servers)
# Set these as environment variables before starting your AI coding tool:
  export SEMOSS_ACCESS_KEY="your-access-key-here"
  export SEMOSS_SECRET_KEY="your-secret-key-here"

# Project Configuration
PROJECT_ID=your-project-uuid-here

# SEMOSS Instance (defaults used if not set)
# SEMOSS_URL=https://your-instance.example.com/
# SEMOSS_DB_ID=your-database-engine-id